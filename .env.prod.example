# Production env template
# Copy to .env.prod and fill secrets before deployment

APP_IMAGE_NAME=cqwu-appointment-system
APP_IMAGE_TAG=latest
FRONTEND_IMAGE_NAME=cqwu-appointment-frontend
FRONTEND_IMAGE_TAG=latest
FRONTEND_REPO_PATH=./cqwu_appointment_system_vue
MYSQL_IMAGE=mysql:8.0
REDIS_IMAGE=redis:7-alpine
MINIO_IMAGE=minio/minio:latest
MINIO_MC_IMAGE=minio/mc:latest

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8081
APP_TIME_ZONE=Asia/Shanghai
DB_SERVER_TIMEZONE=Asia/Shanghai
APP_BIND_ADDRESS=127.0.0.1
FRONTEND_BIND_ADDRESS=0.0.0.0
FRONTEND_PUBLIC_PORT=80

DB_HOST=mysql
DB_PORT=3306
DB_NAME=cqwu
DB_USERNAME=cqwu
DB_PASSWORD=REPLACE_DB_PASSWORD

MYSQL_DATABASE=cqwu
MYSQL_ROOT_PASSWORD=REPLACE_MYSQL_ROOT_PASSWORD

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_REDIS_PASSWORD

MINIO_DATA_PUBLIC_PORT=1900
MINIO_ROOT_USER=cqwu
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_ENDPOINT=http://your-vm-ip:1900
MINIO_ACCESS_KEY=cqwu
MINIO_SECRET_KEY=REPLACE_MINIO_SECRET_KEY
MINIO_BUCKET_NAME=cqwu-appointment

JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET
JWT_ACCESS_TOKEN_EXPIRE_TIME=2H
JWT_REFRESH_TOKEN_EXPIRE_TIME=7D
JPA_DDL_AUTO=update
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com,http://your-vm-ip:80
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-Requested-With
CORS_EXPOSED_HEADERS=Authorization,Content-Disposition
CORS_ALLOW_CREDENTIALS=false
CORS_MAX_AGE_SECONDS=3600

JAVA_TOOL_OPTIONS=-Xms768m -Xmx2g -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -XX:+ParallelRefProcEnabled -XX:+HeapDumpOnOutOfMemoryError
LOG_PATH=./logs/cqwu_appointment_system

MYSQL_CPUS=2.0
MYSQL_MEM_LIMIT=4g
REDIS_CPUS=0.3
REDIS_MEM_LIMIT=512m
MINIO_CPUS=0.8
MINIO_MEM_LIMIT=1536m
APP_CPUS=2.2
APP_MEM_LIMIT=3g
FRONTEND_CPUS=1.2
FRONTEND_MEM_LIMIT=2g
