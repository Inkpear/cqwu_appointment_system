# Minimal production env for this project
# Copy to .env.prod and replace all REPLACE_* values.

SPRING_PROFILES_ACTIVE=prod
APP_TIME_ZONE=Asia/Shanghai
DB_SERVER_TIMEZONE=Asia/Shanghai

# --- App security ---
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET

# --- MySQL ---
MYSQL_ROOT_PASSWORD=REPLACE_MYSQL_ROOT_PASSWORD
DB_PASSWORD=REPLACE_DB_PASSWORD

# --- Redis ---
REDIS_PASSWORD=REPLACE_REDIS_PASSWORD

# --- MinIO ---
# Username/access-key defaults to cqwu in docker-compose
MINIO_SECRET_KEY=REPLACE_MINIO_SECRET_KEY
MINIO_PUBLIC_ENDPOINT=http://your-vm-ip:1900

# --- Optional safety ---
JPA_DDL_AUTO=update

# --- CAS SSO (must match CAS service registry) ---
CAS_ENABLED=true
CAS_CLIENT_SERVICE_URL=https://math-bookingroom.cqwu.edu.cn/api/auth/cas/callback
CAS_FRONTEND_REDIRECT_URL=https://math-bookingroom.cqwu.edu.cn/login/callback
